# Env
CONFIG_ENV_IS_NOWHERE=y
CONFIG_ENV_IS_IN_MMC=n

# MMC
CONFIG_SUPPORT_EMMC_RPMB=y

# Console
CONFIG_DISABLE_CONSOLE=y
CONFIG_LOGLEVEL=0
CONFIG_SILENT_CONSOLE=y

# Android Verified Boot
CONFIG_AVB_VERIFY=y
CONFIG_LIBAVB=y
CONFIG_CMD_AVB=y

# OP-TEE
CONFIG_TEE=y
CONFIG_OPTEE=y
CONFIG_OPTEE_TA_AVB=y
CONFIG_CMD_OPTEE_RPMB=y

# Boot
CONFIG_BOOTDELAY=0
