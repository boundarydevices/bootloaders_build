/*
 * U-Boot uImage source file with multiple kernels, ramdisks and FDT blobs
 */

/dts-v1/;

/ {
        description = "FIT image";
        #address-cells = <1>;

        images {
                uboot {
                        description = "U-Boot";
                        type = "standalone";
                        /* Warning: os field voluntary not specified */
                        /* We don't want let spl_load_simple_fit spl_fit_append_fdt */
                        arch = "arm64";
                        compression = "none";
                        load = <0x41000000>;
                        entry = <0x41000000>;
                        data = /incbin/("u-boot.bin");
                };

                atf {
                        description = "ARM Trusted Firmware";
                        type = "firmware";
                        os = "arm-trusted-firmware";
                        arch = "arm64";
                        compression = "none";
                        entry = <0x54601000>;
                        load = <0x54601000>;
                        data = /incbin/("bl31.bin");
                };

                optee {
                        description = "OP-TEE";
                        type = "firmware";
                        os = "tee";
                        arch = "arm64";
                        compression = "none";
                        load = <0x431fffe4>;
                        entry = <0x43200000>;
                        data = /incbin/("tee.bin");
                };
        };

        configurations {
                default = "conf";
                conf {
                        description = "mt8390";
                        firmware = "atf";
                        loadables = "optee", "uboot";
                };
        };
};
